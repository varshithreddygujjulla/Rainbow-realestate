<% const siteSettings = typeof settings !== "undefined" ? settings : null; %>

<footer class="footer">
<div class="footer-container container">
    <!-- Company Info -->
    <div class="footer-section">
      <h3>Rainbow Developers & Agro Farms</h3>
      <p class="footer-tagline">Building Premium Real Estate</p>
      <p class="footer-description">
        We specialize in developing premium residential layouts with transparent 
        documentation and sustainable community planning.
      </p>
    </div>

    <!-- Quick Links -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/completed-projects">Completed Projects</a></li>
        <li><a href="/ongoing-projects">Ongoing Projects</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

   <!-- Contact Info -->
<div class="footer-section">

  <h4>Contact Us</h4>

 <% if (siteSettings?.phoneNumber) { %>
  <p>
    Phone:
    <%= siteSettings.phoneNumber %>
  </p>
<% } %>

  <% if (siteSettings?.email) { %>
    <p>
      Email:
      <%= siteSettings.email %>
    </p>
  <% } %>

  <% if (siteSettings?.address) { %>
    <p>
      Address:
      <%= siteSettings.address %>
    </p>
  <% } %>

</div>

    <!-- Social Links -->
    <div class="footer-section">
      <h4>Follow Us</h4>
      <div class="social-links">
        <% if (siteSettings && siteSettings.facebookUrl) { %>
          <a href="<%= siteSettings.facebookUrl %>" target="_blank" class="social-link">Facebook</a>
        <% } %>

        <% if (siteSettings && siteSettings.instagramUrl) { %>
          <a href="<%= siteSettings.instagramUrl %>" target="_blank" class="social-link">Instagram</a>
        <% } %>

        <% if (siteSettings && siteSettings.whatsappNumber) { %>
          <a href="https://wa.me/<%= siteSettings.whatsappNumber %>" target="_blank" class="social-link">WhatsApp</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <p>
      <% if (siteSettings && siteSettings.footerText) { %>
        <%= siteSettings.footerText %>
      <% } else { %>
        © 2024 Rainbow Developers & Agro Farms. All rights reserved.
      <% } %>
    </p>
  </div>
</footer>