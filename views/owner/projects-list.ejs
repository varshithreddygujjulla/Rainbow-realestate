<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/ownerSidebar.ejs') %>

    <!-- Main Content -->
    <main class="admin-main">
      <!-- Header -->
      <div class="admin-header">
        <h1>All Projects</h1>
        <p>Manage all your real estate projects</p>
      </div>

      <!-- Alerts -->
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success">
          <%= success[0] %>
        </div>
      <% } %>

      <% if (error && error.length > 0) { %>
        <div class="alert alert-error">
          <%= error[0] %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="action-bar">
        <a href="/owner/projects/add" class="btn btn-primary">+ Add New Project</a>
      </div>

      <!-- Projects Section -->
      <section class="dashboard-section">
        <% if (projects && projects.length > 0) { %>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Project Name</th>
                  <th>Location</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Total Area</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% projects.forEach(project => { %>
                  <tr>
                    <td>
                      <strong><%= project.name %></strong>
                      <br>
                      <small style="color: #999;">Slug: <%= project.slug %></small>
                    </td>
                    <td><%= project.location %></td>
                    <td>
                      <span class="badge <%= project.category === 'Completed' ? 'badge-success' : project.category === 'Ongoing' ? 'badge-info' : 'badge-warning' %>">
                        <%= project.category %>
                      </span>
                    </td>
                    <td><%= project.statusText %></td>
                    <td><%= project.totalArea %></td>
                    <td><%= new Date(project.createdAt).toLocaleDateString() %></td>
                    <td>
                      <div class="action-buttons">
                        <a href="/owner/projects/edit/<%= project._id %>" class="btn-small btn-edit">Edit</a>
                        <form action="/owner/projects/delete/<%= project._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this project?');">
                          <button type="submit" class="btn-small btn-delete">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="projects-summary">
            <p>Total Projects: <strong><%= projects.length %></strong></p>
          </div>
        <% } else { %>
          <div class="no-data-message">
            <p>No projects created yet.</p>
            <a href="/owner/projects/add" class="btn btn-primary">Create First Project</a>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>