<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="admin-layout">

<%- include('../partials/ownerSidebar.ejs') %>

<main class="admin-main">

<h1>Edit Project</h1>

<% if (success?.length) { %>
  <div class="alert success"><%= success[0] %></div>
<% } %>

<% if (error?.length) { %>
  <div class="alert error"><%= error[0] %></div>
<% } %>

<% if (!project) { %>
  <p>Project not found</p>
<% } else { %>

<form method="POST" action="/owner/projects/<%= project._id %>/edit?_method=PUT">

<!-- BASIC -->
<input type="text" name="name" value="<%= project.name %>" required>
<input type="text" name="location" value="<%= project.location %>" required>

<input type="text" name="district" value="<%= project.district || '' %>">

<select name="category">
  <option value="Completed" <%= project.category==='Completed'?'selected':'' %>>Completed</option>
  <option value="Ongoing" <%= project.category==='Ongoing'?'selected':'' %>>Ongoing</option>
  <option value="Upcoming" <%= project.category==='Upcoming'?'selected':'' %>>Upcoming</option>
</select>

<label>
  <input type="checkbox" name="isFeatured" <%= project.isFeatured ? 'checked' : '' %>>
  Featured
</label>

<!-- AREA -->
<input type="text" name="totalArea" value="<%= project.totalArea || '' %>">
<input type="text" name="plotArea" value="<%= project.plotArea || '' %>">

<input type="text" name="approvalType" value="<%= project.approvalType || '' %>">
<input type="text" name="statusText" value="<%= project.statusText || '' %>">

<!-- ✅ FIXED -->
<input type="number" name="completedYear" value="<%= project.completedYear || '' %>">

<!-- DESCRIPTION -->
<textarea name="shortDescription"><%= project.shortDescription || '' %></textarea>
<textarea name="description"><%= project.fullDescription || '' %></textarea>

<!-- AMENITIES -->
<textarea name="amenities"><%= (project.amenities || []).join('\n') %></textarea>
<textarea name="highlights"><%= (project.highlights || []).join('\n') %></textarea>

<button type="submit">Update</button>

</form>

<!-- HERO -->
<h3>Hero Image</h3>

<img 
  src="<%= project.heroImage?.url || '/images/placeholder.jpg' %>" 
  style="max-width:300px;"
>

<form method="POST" enctype="multipart/form-data" action="/owner/projects/<%= project._id %>/hero">
  <input type="file" name="heroImage" accept="image/jpeg,image/png,image/webp">
  <button>Upload</button>
</form>

<!-- PHOTOS -->
<h3>Gallery</h3>

<form method="POST" enctype="multipart/form-data" action="/owner/projects/<%= project._id %>/photos">
  <input type="file" name="photos" multiple accept="image/jpeg,image/png,image/webp">
  <button>Upload</button>
</form>

<% project.photos?.forEach(p => { %>
  <img src="<%= p.url %>" style="width:120px;">
  <form method="POST" action="/owner/projects/<%= project._id %>/photos/<%= p._id %>?_method=DELETE">
    <button>Delete</button>
  </form>
<% }) %>

<!-- VIDEOS -->
<h3>Videos</h3>

<form method="POST" action="/owner/projects/<%= project._id %>/videos">
  <input name="videoTitle">
  <input name="videoUrl" required>
  <button>Add</button>
</form>

<% project.videos?.forEach(v => { %>
  <p><%= v.title %></p>
  <form method="POST" action="/owner/projects/<%= project._id %>/videos/<%= v._id %>?_method=DELETE">
    <button>Delete</button>
  </form>
<% }) %>

<% } %>

</main>
</div>

</body>
</html>