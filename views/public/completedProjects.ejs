<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Rainbow Developers</title>
  <meta name="description" content="Browse our successfully completed real estate projects across Telangana. Premium plots delivered with transparent documentation and customer satisfaction.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include('../partials/navbar.ejs') %>

<!-- HERO -->
<section class="inner-hero">
  <div class="inner-hero-overlay">
    <div class="container">
      <div class="inner-hero-content">
        <span class="hero-subtitle-label">Our Completed Projects</span>
        <h1>Delivering<br><em>Excellence</em><br>Every Time</h1>
        <p>
          Over the years, we have successfully delivered premium open plots and layouts
          in prime locations across Telangana — each one a benchmark of quality and trust.
        </p>
        <a href="/ongoing-projects" class="btn-primary">
          View Ongoing Projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section class="projects-section">
  <div class="container">

    <div class="section-heading">
      <span>Our Track Record</span>
      <h2>Premium Developments Delivered</h2>
      <p>Each project reflects our commitment to quality, transparency, and long-term customer satisfaction.</p>
    </div>

    <% if (projects && projects.length > 0) { %>
      <% projects.forEach((project, index) => { %>

        <div class="project-showcase reveal-up <%= index % 2 !== 0 ? 'reverse' : '' %>">

          <div class="showcase-image">
            <% if (project.heroImage && project.heroImage.url) { %>
              <img src="<%= project.heroImage.url %>" alt="<%= project.name %>" loading="lazy">
            <% } else { %>
              <img src="/images/hero1.jpg" alt="<%= project.name %>" loading="lazy">
            <% } %>
            <div class="showcase-badge badge-completed">Completed</div>
          </div>

          <div class="showcase-content">

            <% if (project.approvalType) { %>
              <span class="approval-tag" style="margin-bottom:16px;"><%= project.approvalType %></span>
            <% } %>

            <h2><%= project.name %></h2>

            <p class="showcase-location">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= project.location %>
            </p>

            <p class="showcase-description">
              <%= project.shortDescription && project.shortDescription.trim() !== ''
                  ? project.shortDescription
                  : 'Premium plotted development with excellent connectivity and long-term investment value.' %>
            </p>

            <div class="showcase-meta">
              <div class="meta-box">
                <span>Total Area</span>
                <strong><%= project.totalArea && project.totalArea.trim() !== '' ? project.totalArea : 'N/A' %></strong>
              </div>
              <div class="meta-box">
                <span>Plot Area</span>
                <strong><%= project.plotArea && project.plotArea.trim() !== '' ? project.plotArea : 'N/A' %></strong>
              </div>
              <div class="meta-box">
                <span>Approval</span>
                <strong><%= project.approvalType && project.approvalType.trim() !== '' ? project.approvalType : 'N/A' %></strong>
              </div>
              <div class="meta-box">
                <span>Status</span>
                <strong><%= project.statusText && project.statusText.trim() !== '' ? project.statusText : 'Completed' %></strong>
              </div>
            </div>

            <a href="/projects/<%= project.slug %>" class="btn-primary">
              View Project
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

          </div>

        </div>

      <% }) %>
    <% } else { %>
      <div class="no-data-message">
        <p>No completed projects available yet.</p>
      </div>
    <% } %>

  </div>
</section>

<!-- CTA -->
<section class="projects-cta">
  <div class="container">
    <h2>Inspired by Our Work?</h2>
    <p>Explore our ongoing developments and book your dream plot today.</p>
    <div class="cta-buttons">
      <a href="/ongoing-projects" class="btn-primary">
        View Ongoing Projects
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/contact" class="btn-outline-white">Contact Us</a>
    </div>
  </div>
</section>

<!-- FLOATING WHATSAPP -->
<% if (settings?.whatsappNumber) { %>
<a href="https://wa.me/<%= settings.whatsappNumber %>" class="whatsapp-float" target="_blank" aria-label="Chat on WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>
<% } %>

<%- include('../partials/footer.ejs') %>

<script src="/js/main.js"></script>

</body>
</html>
