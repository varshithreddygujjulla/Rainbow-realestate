<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project ? project.name : 'Project Not Found' %> - Rainbow Developers</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- Navigation -->
<%- include('../partials/navbar.ejs') %>

<main>

<% if (project) { %>

<!-- HERO -->
<section class="project-hero">

  <img 
    src="<%= project.heroImage && project.heroImage.url ? project.heroImage.url : '/images/placeholder.jpg' %>" 
    alt="<%= project.name %>" 
    class="hero-image"
  >

  <div class="hero-overlay">
    <h1><%= project.name %></h1>

    <p class="location">
      <%= project.location %>
      <%= project.district ? ', ' + project.district : '' %>
    </p>
  </div>

</section>

<!-- OVERVIEW -->
<section class="project-overview">

  <div class="container">

    <h2 class="section-title">
      Project Overview
    </h2>

    <div class="overview-grid">

      <div class="overview-card">
        <span>📍</span>
        <h4>Location</h4>

        <p>
          <%= project.location %>
          <%= project.district ? ', ' + project.district : '' %>
        </p>
      </div>

      <% if (project.totalArea) { %>
      <div class="overview-card">
        <span>📐</span>
        <h4>Total Area</h4>
        <p><%= project.totalArea %></p>
      </div>
      <% } %>

      <% if (project.plotArea) { %>
      <div class="overview-card">
        <span>📏</span>
        <h4>Plot Size</h4>
        <p><%= project.plotArea %></p>
      </div>
      <% } %>

      <% if (project.approvalType) { %>
      <div class="overview-card">
        <span>✅</span>
        <h4>Approval</h4>
        <p><%= project.approvalType %></p>
      </div>
      <% } %>

      <% if (project.statusText) { %>
      <div class="overview-card highlight">
        <span>📊</span>
        <h4>Status</h4>
        <p><%= project.statusText %></p>
      </div>
      <% } %>

    </div>

  </div>

</section>

<!-- DESCRIPTION -->
<% if (project.fullDescription) { %>

<section class="project-description">

  <div class="container">

    <h2>About This Project</h2>

    <p>
      <%= project.fullDescription %>
    </p>

  </div>

</section>

<% } %>

<!-- GALLERY -->
<% if (project.photos && project.photos.length > 0) { %>

<section class="project-gallery">

  <div class="container">

    <h2 class="section-title">
      Gallery
    </h2>

    <div class="gallery-grid">

      <% project.photos.forEach(photo => { %>

        <img 
          src="<%= photo.url %>" 
          alt="Project Image"
          onclick="openLightbox('<%= photo.url %>')"
        >

      <% }) %>

    </div>

  </div>

</section>

<% } %>

<!-- VIDEOS -->
<% if (project.videos && project.videos.length > 0) { %>

<section class="project-videos">

  <div class="container">

    <h2 class="section-title">
      Project Videos
    </h2>

    <div class="videos-grid">

      <% project.videos.forEach(video => { %>

        <% 
          let videoId = '';
          let url = video.url || '';

          if (url.includes('watch?v=')) {
            videoId = url.split('watch?v=')[1];
          } else if (url.includes('youtu.be/')) {
            videoId = url.split('youtu.be/')[1];
          } else if (url.includes('/shorts/')) {
            videoId = url.split('/shorts/')[1];
          }

          if (videoId.includes('&')) {
            videoId = videoId.split('&')[0];
          }
        %>

        <% if (videoId) { %>

        <div class="video-card">

          <iframe
            src="https://www.youtube.com/embed/<%= videoId %>"
            allowfullscreen>
          </iframe>

          <p><%= video.title %></p>

        </div>

        <% } %>

      <% }) %>

    </div>

  </div>

</section>

<% } %>

<!-- AMENITIES -->
<% if (project.amenities && project.amenities.length > 0) { %>

<section class="project-amenities">

  <div class="container">

    <h2>Amenities</h2>

    <ul class="amenities-list">

      <% project.amenities.forEach(amenity => { %>

        <li>✓ <%= amenity %></li>

      <% }) %>

    </ul>

  </div>

</section>

<% } %>

<!-- HIGHLIGHTS -->
<% if (project.highlights && project.highlights.length > 0) { %>

<section class="project-highlights">

  <div class="container">

    <h2>Highlights</h2>

    <ul>

      <% project.highlights.forEach(h => { %>

        <li>★ <%= h %></li>

      <% }) %>

    </ul>

  </div>

</section>

<% } %>

<!-- CTA -->
<section class="cta-section">

  <div class="container cta-box">

    <div>

      <h2>
        Your Dream Plot is Just One Step Away!
      </h2>

      <p>
        Limited plots available — Book your visit today
      </p>

    </div>

    <div class="cta-buttons">

      <a href="/contact" class="btn-primary">
        Contact Us
      </a>

      <% if (settings && settings.whatsappNumber) { %>

      <a 
        href="https://wa.me/<%= settings.whatsappNumber %>" 
        class="btn-secondary"
        target="_blank"
      >
        WhatsApp
      </a>

      <% } %>

    </div>

  </div>

</section>

<!-- FOOTER -->
<%- include('../partials/footer.ejs') %>

<!-- FLOATING WHATSAPP -->
<% if (settings && settings.whatsappNumber) { %>

<a 
  href="https://wa.me/<%= settings.whatsappNumber %>"
  class="whatsapp-float"
  target="_blank"
>
  💬
</a>

<% } %>

<!-- STICKY BAR -->
<div class="sticky-bar">

  <a href="tel:<%= settings && settings.phoneNumber ? settings.phoneNumber : '' %>">
    📞 Call
  </a>

  <% if (settings && settings.whatsappNumber) { %>

  <a href="https://wa.me/<%= settings.whatsappNumber %>">
    💬 WhatsApp
  </a>

  <% } %>

</div>

<!-- LIGHTBOX -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <img id="lightbox-img">
</div>

<script src="/js/main.js"></script>

<script>

function openLightbox(src) {
  document.getElementById('lightbox').style.display = 'flex';
  document.getElementById('lightbox-img').src = src;
}

function closeLightbox() {
  document.getElementById('lightbox').style.display = 'none';
}

</script>

<% } else { %>

<section class="container" style="padding:100px 0; text-align:center;">

  <h1>Project Not Found</h1>

  <p>
    The requested project does not exist.
  </p>

  <a href="/" class="btn-primary">
    Go Home
  </a>

</section>

<% } %>

</main>

</body>
</html>