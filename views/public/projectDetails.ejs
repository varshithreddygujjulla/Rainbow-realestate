<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project ? project.name : 'Project Not Found' %> | Rainbow Developers</title>
  <meta name="description" content="<%= project ? project.name + ' — ' + (project.shortDescription || 'Premium plot development by Rainbow Developers in ' + (project.location || 'Telangana')) : 'Project details' %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include('../partials/navbar.ejs') %>

<main>

<% if (project) { %>

<!-- HERO -->
<section class="project-hero">
  <img
    src="<%= project.heroImage && project.heroImage.url ? project.heroImage.url : '/images/hero1.jpg' %>"
    alt="<%= project.name %>"
    class="hero-image"
  >
  <div class="hero-overlay">
    <div class="container">

      <% if (project.category) { %>
        <span class="hero-subtitle-label" style="color:#a8e6bf; margin-bottom:14px;">
          <%= project.category %> Project
        </span>
      <% } %>

      <h1><%= project.name %></h1>

      <p class="location">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= project.location %><%= project.district ? ', ' + project.district : '' %>
      </p>

    </div>
  </div>
</section>

<!-- OVERVIEW -->
<section class="project-overview">
  <div class="container">

    <div class="section-heading">
      <span>Project Overview</span>
      <h2>Key Project Details</h2>
    </div>

    <div class="overview-grid">

      <div class="overview-card">
        <div class="overview-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h4>Location</h4>
        <p><%= project.location %><%= project.district ? ', ' + project.district : '' %></p>
      </div>

      <% if (project.totalArea) { %>
      <div class="overview-card">
        <div class="overview-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </div>
        <h4>Total Area</h4>
        <p><%= project.totalArea %></p>
      </div>
      <% } %>

      <% if (project.plotArea) { %>
      <div class="overview-card">
        <div class="overview-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 9 9 9 9 3"/><polyline points="21 15 15 15 15 21"/><line x1="3" y1="9" x2="21" y2="15"/></svg>
        </div>
        <h4>Plot Size</h4>
        <p><%= project.plotArea %></p>
      </div>
      <% } %>

      <% if (project.approvalType) { %>
      <div class="overview-card">
        <div class="overview-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <h4>Approval</h4>
        <p><%= project.approvalType %></p>
      </div>
      <% } %>

      <% if (project.statusText) { %>
      <div class="overview-card highlight">
        <div class="overview-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h4>Status</h4>
        <p><%= project.statusText %></p>
      </div>
      <% } %>

    </div>
  </div>
</section>

<!-- DESCRIPTION -->
<% if (project.fullDescription) { %>
<section class="project-description">
  <div class="container">
    <span class="section-label">About This Project</span>
    <h2 class="section-heading-lg">Project Highlights</h2>
    <p><%= project.fullDescription %></p>
  </div>
</section>
<% } %>

<!-- GALLERY -->
<% if (project.photos && project.photos.length > 0) { %>
<section class="project-gallery">
  <div class="container">

    <div class="section-heading">
      <span>Project Gallery</span>
      <h2>Visual Tour</h2>
      <p>Click any image to view in full size.</p>
    </div>

    <div class="gallery-grid">
      <% project.photos.forEach(photo => { %>
        <img
          src="<%= photo.url %>"
          alt="<%= project.name %> gallery image"
          loading="lazy"
          onclick="openLightbox('<%= photo.url %>')"
        >
      <% }) %>
    </div>

  </div>
</section>
<% } %>

<!-- VIDEOS -->
<% if (project.videos && project.videos.length > 0) { %>
<section class="project-videos">
  <div class="container">

    <div class="section-heading">
      <span>Project Videos</span>
      <h2>Watch &amp; Explore</h2>
    </div>

    <div class="videos-grid">
      <% project.videos.forEach(video => { %>

        <%
          let videoId = '';
          let url = video.url || '';

          if (url.includes('watch?v=')) {
            videoId = url.split('watch?v=')[1];
          } else if (url.includes('youtu.be/')) {
            videoId = url.split('youtu.be/')[1];
          } else if (url.includes('/shorts/')) {
            videoId = url.split('/shorts/')[1];
          } else if (url.includes('/live/')) {
            videoId = url.split('/live/')[1];
          } else if (url.includes('/embed/')) {
            videoId = url.split('/embed/')[1];
          }

          if (videoId && videoId.includes('&')) {
            videoId = videoId.split('&')[0];
          }
          if (videoId && videoId.includes('?')) {
            videoId = videoId.split('?')[0];
          }
        %>

        <% if (videoId) { %>
        <div class="video-card">
          <iframe
            src="https://www.youtube.com/embed/<%= videoId %>"
            title="<%= video.title || project.name %>"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy">
          </iframe>
          <% if (video.title) { %>
            <p><%= video.title %></p>
          <% } %>
        </div>
        <% } %>

      <% }) %>
    </div>

  </div>
</section>
<% } %>

<!-- AMENITIES -->
<% if (project.amenities && project.amenities.length > 0) { %>
<section class="project-amenities">
  <div class="container">

    <div class="section-heading">
      <span>Project Amenities</span>
      <h2>Premium Features &amp; Facilities</h2>
    </div>

    <ul class="amenities-list">
      <% project.amenities.forEach(amenity => { %>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <%= amenity %>
        </li>
      <% }) %>
    </ul>

  </div>
</section>
<% } %>

<!-- HIGHLIGHTS -->
<% if (project.highlights && project.highlights.length > 0) { %>
<section class="project-highlights">
  <div class="container">

    <div class="section-heading">
      <span>Key Highlights</span>
      <h2>What Makes This Project Special</h2>
    </div>

    <ul>
      <% project.highlights.forEach(h => { %>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#c9a84c" stroke="#c9a84c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <%= h %>
        </li>
      <% }) %>
    </ul>

  </div>
</section>
<% } %>

<!-- CTA -->
<section class="cta-final">
  <div class="container">
    <div class="cta-inner reveal-up">
      <div class="cta-text">
        <h2>Interested in <%= project.name %>?</h2>
        <p>Book your free site visit today. Limited plots available — secure yours now.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary btn-lg">
          Contact Us
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <% if (settings?.whatsappNumber) { %>
          <a href="https://wa.me/<%= settings.whatsappNumber %>?text=Hi, I'm interested in <%= encodeURIComponent(project.name) %>" target="_blank" class="btn-whatsapp-cta">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<%- include('../partials/footer.ejs') %>

<!-- FLOATING WHATSAPP -->
<% if (settings?.whatsappNumber) { %>
<a href="https://wa.me/<%= settings.whatsappNumber %>?text=Hi, I'm interested in <%= encodeURIComponent(project.name) %>" class="whatsapp-float" target="_blank" aria-label="Chat on WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>
<% } %>

<!-- STICKY BAR (mobile) -->
<div class="sticky-bar">
  <% if (settings?.phoneNumber) { %>
    <a href="tel:<%= settings.phoneNumber %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Call
    </a>
  <% } %>
  <% if (settings?.whatsappNumber) { %>
    <a href="https://wa.me/<%= settings.whatsappNumber %>?text=Hi, I'm interested in <%= encodeURIComponent(project.name) %>" target="_blank">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle; margin-right:6px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      WhatsApp
    </a>
  <% } %>
</div>

<!-- LIGHTBOX -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <img id="lightbox-img" alt="Project image full size">
</div>

<% } else { %>

<!-- PROJECT NOT FOUND -->
<section class="error-page">
  <div class="container">
    <h1>404</h1>
    <h2>Project Not Found</h2>
    <p>The project you're looking for doesn't exist or has been removed.</p>
    <a href="/" class="btn-primary">
      Go Back Home
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<%- include('../partials/footer.ejs') %>

<% } %>

</main>

<script src="/js/main.js"></script>

</body>
</html>
