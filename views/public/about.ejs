<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Navbar -->
  <%- include('../partials/navbar.ejs') %>

  <!-- Page Header -->
 <section class="page-header about-hero">
    <h1>About Rainbow Developers & Agro Farms</h1>
  </section>

  <!-- About Content -->
  <section class="about-section">
    <div class="container">
      <div class="about-content fade-up">
        <div class="about-text">
          <h2>Our Story</h2>
          <% if (settings && settings.aboutText) { %>
            <p><%= settings.aboutText %></p>
          <% } else { %>
            <p>
              Rainbow Developers & Agro Farms is committed to developing premium residential 
              layouts with a focus on sustainability, transparency, and community planning. 
              With over a decade of experience, we have successfully completed multiple projects 
              across Telangana, delivering value to thousands of satisfied customers.
            </p>
            <p>
              Our approach combines modern infrastructure with greenery and peaceful surroundings, 
              creating ideal living spaces for families and investors. We believe in transparent 
              documentation and long-term customer relationships.
            </p>
          <% } %>
        </div>

        <div class="about-stats">
          <div class="stat-box">
            <h3>8+</h3>
            <p>Successful Projects</p>
          </div>
          <div class="stat-box">
            <h3>400+</h3>
            <p>Happy Customers</p>
          </div>
          <div class="stat-box">
            <h3>361+</h3>
            <p>Acres Developed</p>
          </div>
          <div class="stat-box">
            <h3>3</h3>
            <p>Districts Covered</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="why-choose-us">
    <div class="container">
      <h2 class="section-title">Why Choose Us</h2>
      
      <div class="features-grid fade-up">
        <div class="feature-box">
          <div class="feature-icon">✓</div>
          <h3>Transparent Documentation</h3>
          <p>Clear and authentic paperwork for every project</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon">🌿</div>
          <h3>Greenery Focus</h3>
          <p>Avenue plantation and peaceful surroundings</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon">📐</div>
          <h3>Planned Layouts</h3>
          <p>Well-organized designs with clear plot demarcation</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon">🔗</div>
          <h3>Good Connectivity</h3>
          <p>Strategic locations with excellent road access</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon">📈</div>
          <h3>Investment Potential</h3>
          <p>Strong appreciation and long-term value</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon">🤝</div>
          <h3>Customer Support</h3>
          <p>Dedicated support throughout your journey</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Invest?</h2>
      <p>Connect with us to explore our available projects</p>
      <a href="/contact" class="btn btn-white">Contact Us Today</a>
    </div>
  </section>

  <!-- Footer -->
  <%- include('../partials/footer.ejs') %>

  <script src="/js/main.js"></script>
</body>
</html>