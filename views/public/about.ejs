<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Rainbow Developers</title>
  <meta name="description" content="Learn about Rainbow Developers & Agro Farms — a decade of trusted premium real estate development across Telangana with 400+ happy customers.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include('../partials/navbar.ejs') %>

<!-- HERO -->
<section class="inner-hero">
  <div class="inner-hero-overlay">
    <div class="container">
      <div class="inner-hero-content">
        <span class="hero-subtitle-label">About Us</span>
        <h1>Building Trust,<br><em>One Plot</em><br>At A Time</h1>
        <p>
          A decade of delivering premium residential layouts with transparency,
          sustainability, and a commitment to customer satisfaction.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT CONTENT -->
<section class="about-section">
  <div class="container">

    <div class="about-content">

      <div class="about-text reveal-left">
        <span class="section-label">Our Story</span>
        <h2 class="section-heading-lg">Rainbow Developers &amp; Agro Farms</h2>

        <% if (settings && settings.aboutText) { %>
          <p><%= settings.aboutText %></p>
        <% } else { %>
          <p>
            Rainbow Developers &amp; Agro Farms is committed to developing premium residential
            layouts with a focus on sustainability, transparency, and community planning.
            With over a decade of experience, we have successfully completed multiple projects
            across Telangana, delivering value to thousands of satisfied customers.
          </p>
          <p>
            Our approach combines modern infrastructure with greenery and peaceful surroundings,
            creating ideal living spaces for families and investors. We believe in transparent
            documentation and long-term customer relationships built on trust.
          </p>
        <% } %>
      </div>

      <div class="about-stats reveal-right">
        <div class="stat-box">
          <h3>8+</h3>
          <p>Successful Projects</p>
        </div>
        <div class="stat-box">
          <h3>400+</h3>
          <p>Happy Customers</p>
        </div>
        <div class="stat-box">
          <h3>361+</h3>
          <p>Acres Developed</p>
        </div>
        <div class="stat-box">
          <h3>3</h3>
          <p>Districts Covered</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="why-choose-us">
  <div class="container">

    <div class="section-heading">
      <span>Why Choose Us</span>
      <h2>What Sets Us Apart</h2>
      <p>Six pillars that define every project we deliver.</p>
    </div>

    <div class="features-grid">

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-6 0v4"/><rect x="2" y="9" width="20" height="13" rx="2" ry="2"/></svg>
        </div>
        <h3>Transparent Documentation</h3>
        <p>Clear and authentic paperwork for every project we deliver.</p>
      </div>

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L4 7v6c0 5 3.5 9 8 9s8-4 8-9V7l-8-5z"/></svg>
        </div>
        <h3>Greenery Focus</h3>
        <p>Avenue plantation and peaceful surroundings on every layout.</p>
      </div>

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <h3>Planned Layouts</h3>
        <p>Well-organized designs with clear plot demarcation and roads.</p>
      </div>

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <h3>Good Connectivity</h3>
        <p>Strategic locations with excellent road and highway access.</p>
      </div>

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <h3>Investment Potential</h3>
        <p>Strong appreciation and long-term value across all projects.</p>
      </div>

      <div class="feature-box reveal-card">
        <div class="feature-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a6b3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Customer Support</h3>
        <p>Dedicated support throughout your buying journey.</p>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-final">
  <div class="container">
    <div class="cta-inner reveal-up">
      <div class="cta-text">
        <h2>Ready to Invest<br>in Your Future?</h2>
        <p>Connect with us to explore our available projects and book a free site visit.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary btn-lg">
          Contact Us
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <% if (settings?.whatsappNumber) { %>
          <a href="https://wa.me/<%= settings.whatsappNumber %>" target="_blank" class="btn-whatsapp-cta">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- FLOATING WHATSAPP -->
<% if (settings?.whatsappNumber) { %>
<a href="https://wa.me/<%= settings.whatsappNumber %>" class="whatsapp-float" target="_blank" aria-label="Chat on WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>
<% } %>

<%- include('../partials/footer.ejs') %>

<script src="/js/main.js"></script>

</body>
</html>
