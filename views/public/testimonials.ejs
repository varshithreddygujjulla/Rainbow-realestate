          <p class="testimonial-author">- Arjun Reddy</p>
          <p class="testimonial-project">Sree Ganesh Nagar</p>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
