# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rainbow-realty

# ==================== SERVER ====================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ==================== SESSION ====================
SESSION_SECRET=your-super-secret-key

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=your-cloud-name
